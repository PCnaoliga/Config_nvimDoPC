# ============================================
# Arquivos que DEVEM ser versionados
# NOTA: lazy-lock.json NÃO deve estar aqui!
# ============================================

# ============================================
# Arquivos de sistema e editor
# ============================================
*.swp
*.swo
*.un~
*.orig
*.rej
.DS_Store
Thumbs.db
._*

# ============================================
# Arquivos de teste e debug
# ============================================
tt.*
.tests
debug
.repro
foo.*
data

# ============================================
# Diretórios de instalação (NUNCA versionar)
# ============================================
.nvim/          # Diretório de instalação/cache do Neovim
.lazy/          # Plugins instalados pelo lazy.nvim
.undo/          # Histórico de undo local
backup/         # Backups locais
swap/           # Arquivos de swap
spell/          # Arquivos de dicionário
pack/           # Plugins antigos (se usar vim-packager)

# ============================================
# Arquivos de sessão e logs
# ============================================
Session.vim
*.log
*.log.*
*.pid
.viminfo
.nviminfo
viminfo
shadafile

# ============================================
# Arquivos de documentação (gerados)
# ============================================
doc/tags
help-tags
*.hlp
*.pdf

# ============================================
# Configurações do lazy.nvim
# ============================================
# NÃO IGNORAR o lazy-lock.json - ESSENCIAL para reprodutibilidade!
# lazy-lock.json  # ← REMOVIDO - AGORA SERÁ VERSIONADO

# Apenas backups do lock file podem ser ignorados
lazy-lock.json.backup

# ============================================
# Arquivos de dependências (se usar)
# ============================================
node_modules/
venv/
.venv/
env/
.env
__pycache__/
*.pyc

# ============================================
# Arquivos sensíveis (opcional - NUNCA commitar)
# ============================================
.secrets
*.secret
*.key
*.pem
.env.local
.env.production

# ============================================
# Arquivos de compilação/build
# ============================================
*.o
*.so
*.dylib
*.exe
*.dll
dist/
build/
target/

# ============================================
# IDE e editores
# ============================================
.vscode/
.idea/
*.sublime-*
